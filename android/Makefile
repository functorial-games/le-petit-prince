# GNU Make build definition; recipes use only fixed argv at Make's POSIX boundary.
# No authored Bash procedure or alternate shell runtime. Invoke from any directory:
# make -C <absolute checkout> -f android/Makefile host-test BEAUTY=<absolute checkout>
.DELETE_ON_ERROR:
CC ?= cc
NODE ?= node
BEAUTY ?= .beauty-reference
SDK ?= $(ANDROID_HOME)
NDK ?= $(SDK)/ndk/29.0.14206865
TOOLS ?= $(SDK)/build-tools/36.0.0
SIGNING_KEYSTORE ?= .test-signing/_/build/app/wegert-debug.keystore
TOOLCHAIN = $(NDK)/toolchains/llvm/prebuilt/linux-x86_64
CLANG = $(TOOLCHAIN)/bin/armv7a-linux-androideabi21-clang
READELF = $(TOOLCHAIN)/bin/llvm-readelf
GLUE = $(NDK)/sources/android/native_app_glue
NATIVE = android/native
OUT = build/android
LIB = $(OUT)/libpilot_face.so
APK = $(OUT)/le-petit-prince-pilot-face-miro-a1.apk
CORE = $(NATIVE)/face_core.c
DATA = $(NATIVE)/face_data.inc $(NATIVE)/face_data_sizes.h
CFLAGS = -std=c11 -O2 -Wall -Wextra -Werror -I$(NATIVE)
.PHONY: host-test reference-test render-test apk signer ndk-check receipts

build/face-test: $(CORE) android/tests/face_test.c $(NATIVE)/face_core.h $(DATA)
	@mkdir -p build
	$(CC) $(CFLAGS) $(CORE) android/tests/face_test.c -lm -o $@

reference-test: build/face-test
	$(NODE) examples/autogenerated/native-pilot-face/reference.mjs $(BEAUTY) build/generated data
	cmp $(NATIVE)/face_data.inc build/generated/face_data.inc
	cmp $(NATIVE)/face_data_sizes.h build/generated/face_data_sizes.h
	$(NODE) examples/autogenerated/native-pilot-face/reference.mjs $(BEAUTY) build/fixtures fixtures
	build/face-test build/fixtures/inputs.tsv build/fixtures/expected.tsv > build/face-comparison.txt
	cat build/face-comparison.txt

host-test: reference-test
	$(CC) -std=c11 -O2 -Wall -Wextra -Werror core/tiny_planet.c core/test_tiny_planet.c -lm -o build/tiny-planet-test
	build/tiny-planet-test

build/package-gate: android/tests/package_gate.c
	@mkdir -p build
	$(CC) -std=c11 -O2 -Wall -Wextra -Werror $< -o $@

build/render-test: $(CORE) $(NATIVE)/face_ui.c $(NATIVE)/pilot_renderer.c android/tests/render_test.c $(DATA)
	@mkdir -p build/render
	$(CC) $(CFLAGS) $(CORE) $(NATIVE)/face_ui.c $(NATIVE)/pilot_renderer.c android/tests/render_test.c -lEGL -lGLESv2 -lm -o $@

render-test: build/render-test
	@mkdir -p build/render
	LIBGL_ALWAYS_SOFTWARE=1 build/render-test > build/render/receipt.txt
	cat build/render/receipt.txt

ndk-check:
	test -x "$(CLANG)"
	test -f "$(GLUE)/android_native_app_glue.c"
	$(CLANG) --version
	cat "$(NDK)/source.properties"

$(LIB): $(CORE) $(NATIVE)/face_ui.c $(NATIVE)/pilot_renderer.c $(NATIVE)/pilot_android.c $(DATA) $(NATIVE)/face_core.h $(NATIVE)/face_ui.h $(NATIVE)/pilot_renderer.h | ndk-check
	@mkdir -p $(OUT)
	$(CLANG) $(CFLAGS) -fPIC -shared -marm -mfloat-abi=softfp -I"$(GLUE)" $(CORE) $(NATIVE)/face_ui.c $(NATIVE)/pilot_renderer.c $(NATIVE)/pilot_android.c "$(GLUE)/android_native_app_glue.c" -Wl,--no-undefined -Wl,-soname,libpilot_face.so -Wl,-z,max-page-size=4096 -landroid -llog -lEGL -lGLESv2 -lm -o $@

signer:
	@mkdir -p $(OUT)
	test -f "$(SIGNING_KEYSTORE)"
	keytool -exportcert -keystore "$(SIGNING_KEYSTORE)" -storetype PKCS12 -storepass wegert-debug -alias wegert-debug > $(OUT)/actual-cert.der
	cmp android/signing/test-cert.der $(OUT)/actual-cert.der

apk: $(LIB) build/package-gate signer
	$(READELF) -h -A -l -Ws -d $(LIB) > $(OUT)/native-elf.txt
	build/package-gate elf $(LIB)
	@mkdir -p $(OUT)/pkg/lib/armeabi-v7a
	cp $(LIB) $(OUT)/pkg/lib/armeabi-v7a/libpilot_face.so
	"$(TOOLS)/aapt2" link -I "$(SDK)/platforms/android-34/android.jar" --manifest android/AndroidManifest.xml --min-sdk-version 21 --target-sdk-version 34 -o $(OUT)/manifest.apk
	cp $(OUT)/manifest.apk $(OUT)/unaligned.apk
	cd $(OUT)/pkg && zip -q -u ../unaligned.apk lib/armeabi-v7a/libpilot_face.so
	"$(TOOLS)/zipalign" -f 4 $(OUT)/unaligned.apk $(OUT)/aligned.apk
	"$(TOOLS)/apksigner" sign --ks "$(SIGNING_KEYSTORE)" --ks-type PKCS12 --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --ks-key-alias wegert-debug --out $(APK) $(OUT)/aligned.apk
	"$(TOOLS)/zipalign" -c -v 4 $(APK) > $(OUT)/alignment.txt
	"$(TOOLS)/apksigner" verify --verbose --print-certs $(APK) > $(OUT)/signer.txt
	unzip -Z1 $(APK) > $(OUT)/contents.txt
	"$(TOOLS)/aapt2" dump xmltree $(APK) --file AndroidManifest.xml > $(OUT)/manifest.txt
	unzip -p $(APK) lib/armeabi-v7a/libpilot_face.so > $(OUT)/packaged-lib.so
	cmp $(LIB) $(OUT)/packaged-lib.so
	build/package-gate $(LIB) $(OUT)/contents.txt $(OUT)/manifest.txt $(OUT)/signer.txt $(OUT)/native-elf.txt > $(OUT)/package-check.txt
	cat $(OUT)/package-check.txt
	sha256sum $(APK) > $(OUT)/apk.sha256
	sha256sum $(LIB) > $(OUT)/native-library.sha256
	$(MAKE) -f android/Makefile receipts

receipts:
	git rev-parse HEAD > $(OUT)/application-revision.txt
	git -C $(BEAUTY) rev-parse HEAD > $(OUT)/beauty-revision.txt
	git -C .android-substrate rev-parse HEAD > $(OUT)/android-ndk-revision.txt
	$(CLANG) --version > $(OUT)/toolchain.txt
	cp "$(NDK)/source.properties" $(OUT)/ndk-source.properties
	cp build/face-comparison.txt $(OUT)/face-comparison.txt
	cp android/PROVENANCE.md $(OUT)/source-provenance.md
	cat $(OUT)/apk.sha256
